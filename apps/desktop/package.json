{
  "name": "@tui-md/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Read markdown and Mermaid diagrams in a VS Code-style desktop viewer",
  "license": "MIT",
  "author": "Prajwal Hebbar <prajwalhebbaras@gmail.com>",
  "homepage": "https://github.com/prajwal-hebbar-07/tui-md#readme",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build && esbuild electron/main.js --bundle --platform=node --target=node20 --format=esm --external:electron --outfile=electron/main.bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "pnpm run build && electron-builder --publish never",
    "preview": "vite --host 127.0.0.1 --port 5173 --strictPort"
  },
  "devDependencies": {
    "@tui-md/core": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
