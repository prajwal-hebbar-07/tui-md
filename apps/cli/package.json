{
  "name": "tui-md-viewer",
  "version": "0.1.0",
  "description": "Read markdown and Mermaid diagrams in a VS Code-style terminal viewer",
  "license": "MIT",
  "author": "Prajwal Hebbar <prajwalhebbaras@gmail.com>",
  "homepage": "https://github.com/prajwal-hebbar-07/tui-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prajwal-hebbar-07/tui-md.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/prajwal-hebbar-07/tui-md/issues",
  "keywords": [
    "markdown",
    "mermaid",
    "tui",
    "terminal",
    "viewer",
    "cli"
  ],
  "type": "module",
  "bin": {
    "tui-md": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --target=node22 --format=esm --external:ink --external:react --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" && node -e \"import('node:fs').then(fs => fs.chmodSync('dist/cli.js', 0o755))\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('node:fs').copyFileSync('../../' + f, f)\""
  },
  "dependencies": {
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@tui-md/core": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
