{
  "name": "@tui-md/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "tui-md": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" && node -e \"import('node:fs').then(fs => fs.chmodSync('dist/cli.js', 0o755))\""
  },
  "dependencies": {
    "@tui-md/core": "workspace:*",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
